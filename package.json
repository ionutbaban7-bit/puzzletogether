{
  "name": "puzzletogether",
  "private": true,
  "version": "1.0.0",
  "description": "Solve beautiful jigsaw puzzles together, in real time.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development node src/server.js",
    "start": "cross-env NODE_ENV=production node src/server.js",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:protocol": "node scripts/sim-test.mjs && node scripts/coaching-test.mjs",
    "test:load": "node scripts/load-test.mjs",
    "test:e2e": "node scripts/browser-test.mjs && node scripts/coaching-browser-test.mjs"
  },
  "dependencies": {
    "express": "^5.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "playwright": "^1.62.1",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^8.2.2"
  }
}
