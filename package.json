{
  "name": "puzzletogether",
  "private": true,
  "version": "1.0.0",
  "description": "Solve beautiful jigsaw puzzles together, in real time.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development node src/server.js",
    "start": "cross-env NODE_ENV=production node src/server.js",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:protocol": "node scripts/sim-test.mjs && node scripts/jigsaw-layout-test.mjs && node scripts/puzzle-reset-test.mjs && node scripts/coaching-test.mjs && node scripts/canvas-protocol-test.mjs && node scripts/sentence-protocol-test.mjs",
    "test:protocol:canvas": "node scripts/canvas-protocol-test.mjs && node scripts/sentence-protocol-test.mjs",
    "test:load": "node scripts/load-test.mjs",
    "test:e2e": "node scripts/browser-test.mjs && node scripts/coaching-browser-test.mjs && node scripts/canvas-browser-test.mjs",
    "test:e2e:canvas": "node scripts/canvas-browser-test.mjs",
    "catalog:audit": "node scripts/audit-catalog.mjs",
    "catalog:pipeline": "node scripts/catalog-pipeline.mjs",
    "catalog:report": "node scripts/catalog-report.mjs",
    "test:layout": "node scripts/jigsaw-layout-test.mjs",
    "test:puzzle-reset": "node scripts/puzzle-reset-test.mjs",
    "test:lobby-viewport": "LOBBY_ONLY=1 node scripts/jigsaw-browser-test.mjs",
    "catalog:seed-stage5": "node scripts/stage5-catalog-seed.mjs",
    "catalog:finalize-stage5": "node scripts/stage5-catalog-finalize.mjs",
    "catalog:generate-procedural-stage5": "node scripts/generate-stage5-procedural-originals.mjs"
  },
  "dependencies": {
    "express": "^5.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "playwright": "^1.62.1",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^8.2.2"
  }
}
