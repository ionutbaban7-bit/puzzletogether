{
  "name": "puzzletogether",
  "private": true,
  "version": "1.2.0",
  "description": "Solve beautiful jigsaw puzzles together, in real time.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development node src/server.js",
    "start": "cross-env NODE_ENV=production node src/server.js",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:protocol": "node scripts/v2-run-tests.mjs scripts/sim-test.mjs scripts/jigsaw-layout-test.mjs scripts/puzzle-reset-test.mjs scripts/claim-lifecycle-test.mjs",
    "test:load": "node scripts/load-test.mjs",
    "test:render-contract": "node scripts/render-contract-test.mjs",
    "test:e2e": "node scripts/v2-run-tests.mjs scripts/v2-browser-test.mjs",
    "test:e2e:mobile": "node scripts/v2-run-tests.mjs scripts/v2-browser-test.mjs",
    "catalog:audit": "node scripts/audit-catalog.mjs",
    "catalog:pipeline": "node scripts/catalog-pipeline.mjs",
    "catalog:report": "node scripts/catalog-report.mjs",
    "test:layout": "node scripts/jigsaw-layout-test.mjs",
    "test:puzzle-reset": "node scripts/puzzle-reset-test.mjs",
    "catalog:seed-stage5": "node scripts/stage5-catalog-seed.mjs",
    "catalog:finalize-stage5": "node scripts/stage5-catalog-finalize.mjs",
    "catalog:generate-procedural-stage5": "node scripts/generate-stage5-procedural-originals.mjs",
    "test:catalog-serve": "node scripts/catalog-serve-test.mjs",
    "test:claim-lifecycle": "node scripts/claim-lifecycle-test.mjs",
    "test:catalog-compat": "node scripts/retired-catalog-compat-test.mjs",
    "test:security": "node scripts/v2-run-tests.mjs scripts/security-regression-test.mjs scripts/v2-security-test.mjs scripts/upload-guard-test.mjs",
    "test:restart": "node scripts/p0-restart-test.mjs",
    "test:image-scaling": "node scripts/image-scaling-test.mjs"
  },
  "dependencies": {
    "express": "^5.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^8.2.2"
  }
}
